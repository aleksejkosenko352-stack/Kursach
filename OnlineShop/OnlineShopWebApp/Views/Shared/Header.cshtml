<header class="bg-danger text-white">
    <div class="container py-2">
        <!-- Верхняя панель -->
        <div class="d-flex justify-content-between align-items-center">
            <!-- Телефон -->
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-phone fa-lg"></i>
                <a href="tel:+38088888885" class="text-white text-decoration-none">+38088888885</a>
            </div>

            <!-- Соцсети -->
            <div class="d-none d-md-flex gap-3">
                <a href="#" class="text-white fs-5"><i class="fa-brands fa-youtube"></i></a>
                <a href="#" class="text-white fs-5"><i class="fa-brands fa-facebook"></i></a>
                <a href="#" class="text-white fs-5"><i class="fa-brands fa-instagram"></i></a>
            </div>

            <!-- Аккаунт -->
            <div>
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        @await Component.InvokeAsync("Avatar")
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            @User.Identity.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Index">Профиль</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Authorization" asp-action="Logout">Выход</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            Войти
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Authorization" asp-action="Login">Вход</a></li>
                            <li><a class="dropdown-item" asp-controller="Authorization" asp-action="Registration">Регистрация</a></li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Лого и поиск -->
    <div class="bg-light py-3">
        <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <a asp-controller="Home" asp-action="Index" class="h2 text-danger m-0">SHOP POP</a>

            <form asp-area="" asp-controller="Product" asp-action="Search" class="w-100 w-md-auto">
                <div class="input-group">
                    <input type="text" class="form-control" name="search" placeholder="Поиск..." />
                    <button class="btn btn-danger" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Навигация -->
    <nav class="navbar navbar-expand-md navbar-light bg-white shadow-sm">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-md-0">
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-danger" asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-bold text-danger" href="#" role="button" data-bs-toggle="dropdown">Каталог</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Телефоны</a></li>
                            <li><a class="dropdown-item" href="#">Бытовая техника</a></li>
                            <li class="dropdown-submenu dropdown">
                                <a class="dropdown-item dropdown-toggle" href="#" data-bs-toggle="dropdown">Компьютеры</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">Ноутбуки</a></li>
                                    <li><a class="dropdown-item" href="#">Аксессуары</a></li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                    @if (User.IsInRole(Constants.AdminRoleName))
                    {
                        <li class="nav-item"><a class="nav-link fw-bold text-danger" asp-area="Administrator" asp-controller="Home" asp-action="Index">Админка</a></li>
                    }
                    @if (User.IsInRole(Constants.UserRoleName))
                    {
                        <li class="nav-item"><a class="nav-link fw-bold text-danger" asp-controller="Account" asp-action="Index">Кабинет</a></li>
                    }
                </ul>

                <div class="d-flex gap-2 text-dark">
                    <div class="text-dark">
                        @await Component.InvokeAsync("Favourite")
                    </div>
                    <div class="text-dark">
                        @await Component.InvokeAsync("Compare")
                    </div>
                    <div class="text-dark">
                        @await Component.InvokeAsync("Cart")
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>
