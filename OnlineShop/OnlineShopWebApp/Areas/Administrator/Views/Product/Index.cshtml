@model List<ProductViewModel>

@{
    ViewData["Title"] = "Список продуктов";
    int i=1;
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-3">
            @await Html.PartialAsync("AdminMenu")
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm">
                <div class="card-body">

                    @if (Model == null || Model.Count == 0)
                    {
                        <h4 class="text-muted">Список продуктов пуст</h4>

                        <div class="mt-4 d-flex gap-2">
                            <a class="btn btn-outline-warning"
                               asp-controller="Product"
                               asp-action="Add">Добавить продукт</a>

                            <a class="btn btn-outline-primary"
                               asp-controller="Home"
                               asp-action="Index">На главную</a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="mb-0">Список продуктов</h4>

                            <a class="btn btn-success"
                               asp-controller="Product"
                               asp-action="Add">
                                + Добавить продукт
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>№</th>
                                        <th>Название</th>
                                        <th>Изображение</th>
                                        <th>Цена</th>
                                        <th colspan="2">Действия</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var product in Model)
                                    {
                                        <tr>
                                            <th>@i</th>
                                            <td class="fw-semibold">@product.Name</td>
                                            <td>
                                                <img src="@product.ImagesPath[0].URL"
                                                     class="img-thumbnail rounded"
                                                     style="width:60px;" />
                                            </td>
                                            <td class="text-success fw-bold">
                                                @product.Cost ₴
                                            </td>

                                            <td>
                                                <a class="btn btn-outline-primary btn-sm"
                                                   asp-controller="Product"
                                                   asp-action="Edit"
                                                   asp-route-productid="@product.Id">
                                                    Редактировать
                                                </a>
                                            </td>

                                            <td>
                                                <a class="btn btn-outline-danger btn-sm"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#delete-product-@product.Id">
                                                    Удалить
                                                </a>

                                                <div class="modal fade"
                                                     id="delete-product-@product.Id"
                                                     tabindex="-1"
                                                     aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title">
                                                                    Подтвердите удаление
                                                                </h5>
                                                                <button type="button"
                                                                        class="btn-close"
                                                                        data-bs-dismiss="modal">
                                                                </button>
                                                            </div>
                                                            <div class="modal-body">
                                                                Вы действительно хотите удалить
                                                                <strong>@product.Name</strong>?
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button class="btn btn-secondary"
                                                                        data-bs-dismiss="modal">
                                                                    Отмена
                                                                </button>

                                                                <a asp-controller="Product"
                                                                   asp-action="Delete"
                                                                   asp-route-productid="@product.Id"
                                                                   class="btn btn-danger">
                                                                    Удалить
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>

                                        i++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
