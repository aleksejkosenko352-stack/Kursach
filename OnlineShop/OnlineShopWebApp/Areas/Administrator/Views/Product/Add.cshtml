@model ProductViewModel

<div class="container py-4">
    <div class="row">
        <div class="col-lg-3 mb-3">
            @await Html.PartialAsync("AdminMenu")
        </div>

        <div class="col-lg-9">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h4 class="mb-4">Добавить продукт</h4>

                    <form method="post"
                          asp-controller="Product"
                          asp-action="Add"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Название
                            </label>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Введите название продукта" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cost" class="form-label">
                                Цена
                            </label>
                            <div class="input-group">
                                <input asp-for="Cost"
                                       class="form-control"
                                       placeholder="Введите стоимость" />
                                <span class="input-group-text">₴</span>
                            </div>
                            <span asp-validation-for="Cost"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Описание
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Введите описание продукта">
                            </textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="UploadedFiles" class="form-label">
                                Загрузить изображения
                            </label>
                            <input asp-for="UploadedFiles"
                                   type="file"
                                   class="form-control"
                                   multiple />
                            <span asp-validation-for="UploadedFiles"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-success px-4">
                                Сохранить
                            </button>

                            <a class="btn btn-outline-secondary"
                               asp-controller="Product"
                               asp-action="Index">
                                Отмена
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>